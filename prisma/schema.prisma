// Prisma schema untuk Aplikasi Piutang Toko

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  BOSS
  STAFF
}

enum DebtStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  TRANSFER_BCA
  TRANSFER_MANDIRI
  CASH
  OTHER
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         Role
  displayName  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  debtsCreated Debt[] @relation("DebtCreatedBy")

  @@map("users")
}

model Customer {
  id           Int      @id @default(autoincrement())
  fullName     String   @unique
  businessName String
  address      String
  phone        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  debts Debt[]

  @@map("customers")
}

model Debt {
  id          String     @id @default(cuid())
  customerId  Int
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount      Decimal    @db.Decimal(14, 2)
  amountPaid  Decimal    @default(0) @db.Decimal(14, 2)
  status      DebtStatus @default(UNPAID)
  dueDate     DateTime   @db.Date
  paidAt      DateTime?
  createdById String
  createdBy   User       @relation("DebtCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  payments Payment[]

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@map("debts")
}

model Payment {
  id        String        @id @default(cuid())
  debtId    String
  debt      Debt          @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount    Decimal       @db.Decimal(14, 2)
  method    PaymentMethod
  note      String?       @db.VarChar(600)
  paidAt    DateTime      @default(now())
  createdAt DateTime      @default(now())

  @@index([debtId])
  @@map("payments")
}
