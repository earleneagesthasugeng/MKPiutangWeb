# === Database ===
# Connection string MySQL. Isi dengan connection string dari provider MySQL
# cloud anda (mis. Aiven, Railway, PlanetScale, dsb). Harus bisa diakses dari
# internet (bukan MySQL lokal/XAMPP), karena Vercel butuh koneksi dari luar.
DATABASE_URL="mysql://user:password@host:3306/dbname"

# === Sesi Login ===
# String acak panjang untuk menandatangani cookie sesi login. WAJIB diisi
# nilai unik & rahasia sebelum deploy ke production.
# Generate contoh: buka https://generate-secret.vercel.app/32
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# === Kredensial Awal (WAJIB diisi sebelum `npm run db:seed`) ===
# Dipakai untuk mengisi 3 akun awal (boss, staff1, staff2) ke database.
# WAJIB diisi di file .env.local anda sendiri (bukan di sini) — tidak ada
# nilai default/fallback di source code, supaya repo ini aman dipush ke
# GitHub tanpa membocorkan password asli. Password bisa diganti lagi kapan
# saja lewat menu Admin setelah login sebagai boss.
SEED_BOSS_USERNAME="ganti-dengan-username-boss"
SEED_BOSS_PASSWORD="ganti-dengan-password-boss"
SEED_STAFF1_USERNAME="ganti-dengan-username-staff-1"
SEED_STAFF1_PASSWORD="ganti-dengan-password-staff-1"
SEED_STAFF2_USERNAME="ganti-dengan-username-staff-2"
SEED_STAFF2_PASSWORD="ganti-dengan-password-staff-2"

# Nama tampilan (opsional, ada default "Megawati"/"Laila"/"Putu" kalau tidak diisi)
# SEED_BOSS_DISPLAY_NAME="Megawati"
# SEED_STAFF1_DISPLAY_NAME="Laila"
# SEED_STAFF2_DISPLAY_NAME="Putu"
